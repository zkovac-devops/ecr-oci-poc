region                      = "eu-central-1"
replica_region              = "eu-west-1"
github_repo                 = "zkovac-devops/ecr-oci-poc"
prefix                      = "poc"
create_github_oidc_provider = true   # false if the account already has the GitHub OIDC provider
manage_replication          = true   # false if the account already uses ECR replication (it would be overwritten)
